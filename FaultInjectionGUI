    ##### RUN INFERENCE AND CACHE THE RESULT #####

    def refresh_detections(self, faulty_detections=None):
        """
        Runs inference once (or accepts pre-computed faulty detections to
        compare against), draws both sets of boxes onto the image, and
        caches the result as self.base_pixmap. Call this again only when
        you actually want to re-run inference (new image, new fault
        injected, etc.) - NOT on every resize.
        """
        nonfaulty_detections, img_array = get_real_detection(IMAGE_PATH)

        self.base_pixmap = load_image_with_boxes(
            img_array,
            nonfaulty_detections,
            faulty_detections
        )

        self._rescale_to_label()

    ##### FOR WHEN WINDOW IS RESIZED #####

    def resizeEvent(self, event):
        # Only rescales the already-cached pixmap - no inference here
        self._rescale_to_label()
        super().resizeEvent(event)

    def _rescale_to_label(self):
        if self.base_pixmap is None:
            return

        target_size = self.live_video.size()
        scaled = self.base_pixmap.scaled(
            target_size.width(),
            target_size.height(),
            Qt.AspectRatioMode.KeepAspectRatio,
            Qt.TransformationMode.SmoothTransformation
        )
        self.live_video.setPixmap(scaled)
        
############### DRAW A TRAPEZOID ###############

class TrapezoidBar(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setMinimumHeight(60)

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        w = self.width()
        h = self.height()
        cut = 40

        path = QPainterPath()
        path.moveTo(QPointF(0, 0))          # top-left, full width
        path.lineTo(QPointF(w, 0))          # top-right, full width
        path.lineTo(QPointF(w - cut, h))    # bottom-right, pulled inward
        path.lineTo(QPointF(cut, h))        # bottom-left, pulled inward
        path.closeSubpath()

        painter.fillPath(path, QBrush(QColor("#494E6B")))
        
############### DRAW BOTTOM MENU SHAPE ###############

class BottomMenuBar(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setMinimumHeight(60)

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        w = self.width()
        h = self.height()
        corner_cut = 20   # size of the 45-degree cut - equal in both directions for a true 45°

        path = QPainterPath()
        path.moveTo(QPointF(corner_cut, 0))           # start after the top-left cut
        path.lineTo(QPointF(w - corner_cut, 0))       # top edge, stopping before top-right cut
        path.lineTo(QPointF(w, corner_cut))           # diagonal cut on top-right
        path.lineTo(QPointF(w, h))                    # right edge, straight down
        path.lineTo(QPointF(0, h))                    # bottom edge, straight across
        path.lineTo(QPointF(0, corner_cut))           # left edge, straight up
        path.closeSubpath()                           # diagonal cut on top-left, back to start

        painter.fillPath(path, QBrush(QColor("#30365D")))

############### LOAD IMAGE WITH BOXES (faulty + non-faulty) ###############

def load_image_with_boxes(img_array, nonfaulty_detections, faulty_detections=None):
    """
    Draws non-faulty detections in green and faulty detections (if given)
    in red, on the same image, so they can be visually compared directly.
    """
    img = img_array.copy()

    # Non-faulty (baseline / majority-voted) detections
    for (x1, y1, x2, y2), cls, conf in nonfaulty_detections:
        cv2.rectangle(img, (x1, y1), (x2, y2), COLOR_NONFAULTY, 1)
        text = f"{cls}  {conf:.2f}"
        cv2.putText(img, text, (x1, y2 + 14), LABEL_FONT, LABEL_SCALE, COLOR_NONFAULTY, 1, cv2.LINE_AA)

    # Faulty detections, drawn on top in a different color
    if faulty_detections:
        for (x1, y1, x2, y2), cls, conf in faulty_detections:
            cv2.rectangle(img, (x1, y1), (x2, y2), COLOR_FAULTY, 1)
            text = f"{cls}  {conf:.2f}"
            cv2.putText(img, text, (x1, y1 - 5), LABEL_FONT, LABEL_SCALE, COLOR_FAULTY, 1, cv2.LINE_AA)

    img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    h, w, ch = img_rgb.shape
    qimg = QImage(img_rgb.data, w, h, ch * w, QImage.Format.Format_RGB888)
    return QPixmap.fromImage(qimg)

############### GET THE DETECTION ###############

def get_real_detection(path, model_index=0):
    img_tensor = load_image_tensor(path)

    with torch.no_grad():
        raw = models[model_index](img_tensor)

    detect_layer = models[model_index].model[-1]
    preds = raw[0] if isinstance(raw, tuple) else raw
    preds = preds.transpose(1, 2)
    out = detect_layer.postprocess(preds)[0]
    mask = out[:, 4] > 0.25
    out = out[mask]

    img_array = (img_tensor[0].permute(1, 2, 0).cpu().numpy() * 255).astype("uint8")
    img_array = cv2.cvtColor(img_array, cv2.COLOR_RGB2BGR)

    detections = []
    for row in out:
        cx, cy, w, h = row[0].item(), row[1].item(), row[2].item(), row[3].item()
        conf = row[4].item()
        cls = int(row[5].item())
        x1 = int(cx - w / 2)
        y1 = int(cy - h / 2)
        x2 = int(cx + w / 2)
        y2 = int(cy + h / 2)
        detections.append(((x1, y1, x2, y2), cls, conf))

    return detections, img_array

############### PRETTY COLORS ###############

def get_class_color(cls):
    golden_ratio = 0.618033988749895
    hue = (cls * golden_ratio) % 1.0
    r, g, b = colorsys.hsv_to_rgb(hue, 0.85, 1.0)
    return (int(b * 255), int(g * 255), int(r * 255))

