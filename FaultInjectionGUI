    ##### RUN INFERENCE AND CACHE THE RESULT #####

    def refresh_detections(self, faulty_detections=None):
        """
        Runs inference once (or accepts pre-computed faulty detections to
        compare against), draws both sets of boxes onto the image, and
        caches the result as self.base_pixmap. Call this again only when
        you actually want to re-run inference (new image, new fault
        injected, etc.) - NOT on every resize.
        """
        nonfaulty_detections, img_array = get_real_detection(IMAGE_PATH)

        boxed_pixmap = load_image_with_boxes(
            img_array,
            nonfaulty_detections,
            faulty_detections
        )

        self.base_pixmap_gold = boxed_pixmap
        self.base_pixmap_fault = boxed_pixmap

        self._rescale_to_label()

    ##### FOR WHEN WINDOW IS RESIZED #####

    def resizeEvent(self, event):
        self._rescale_to_label()
        self._reposition_sidebar_bars()
        self._reposition_tags()
        self._reposition_count_text()
        super().resizeEvent(event)

    def _reposition_count_text(self):
        left_margin = 55

        gold_parent_height = self.gold_count_number.parentWidget().height()
        number_y = (gold_parent_height - self.gold_count_number.height()) // 2

        self.gold_count_number.move(left_margin, number_y)
        self.gold_count_label.move(
            left_margin + self.gold_count_number.width() + 5,
            number_y + (self.gold_count_number.height() - self.gold_count_label.height()) // 2 + 5
        )

        fault_parent_height = self.fault_count_number.parentWidget().height()
        fault_number_y = (fault_parent_height - self.fault_count_number.height()) // 2

        self.fault_count_number.move(left_margin, fault_number_y)
        self.fault_count_label.move(
            left_margin + self.fault_count_number.width() + 5,
            fault_number_y + (self.fault_count_number.height() - self.fault_count_label.height()) // 2 + 5
        )
    
    def _reposition_tags(self):
        gold_geo = self.live_video_gold.geometry()
        fault_geo = self.live_video_fault.geometry()
        menu_geo = self.bottom_menu.geometry()

        # available vertical space between video bottom and menu top
        gap_top = gold_geo.y() + gold_geo.height()
        gap_bottom = menu_geo.y()
        gap_height = gap_bottom - gap_top

        # center the tag vertically within that gap, never overlapping either side
        tag_y = gap_top + (gap_height - self.gold_tag.height()) // 2

        gold_x = gold_geo.x() + (gold_geo.width() - self.gold_tag.width()) // 2
        self.gold_tag.move(gold_x, tag_y)

        fault_x = fault_geo.x() + (fault_geo.width() - self.fault_tag.width()) // 2
        self.fault_tag.move(fault_x, tag_y)
        
    def _reposition_sidebar_bars(self):
        sidebar_height = self.sidebar.height()
        bottom_margin = 65

        sdc_y = sidebar_height - bottom_margin
        latency_y = sdc_y - 80

        self.latency_label.move(24, latency_y)
