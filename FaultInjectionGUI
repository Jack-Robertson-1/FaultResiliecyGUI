############### LOAD IMAGE WITH BOX ###############

def load_image_with_box(path, box, label_text, confidence):
    img = cv2.imread(path)
    
    x1, y1, x2, y2 = box
    cv2.rectangle(img, (x1, y1), (x2, y2), (180, 0, 180), 3) # 180, 0, 180 is BGR
    
    test = f"{label_text}   {confidence:.2f}"
    cv2.putText(img, label_text, (x1, y2 + 30), cv2.FONT_HERSHEY_SIMPLEX, 1, (180, 0, 180), 2)
        
    img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    h, w, ch = img_rgb.shape
    qimg = QImage(img_rgb.data, w, h, ch * w, QImage.Format.Format_RGB888)
    return QPixmap.fromImage(qimg)

############### GET THE DETECTION ###############

def get_real_detection(path):
    img_tensor = load_image_tensor(path)
    
    # Extract model_a, no need to track gradients
    with torch.no_grad():
        raw = models[0](img_tensor)

    # reuse decode_output's internal logic but keep box coordinates too
    detect_layer = models[0].model[-1]
    preds = raw[0] if isinstance(raw, tuple) else raw
    preds = preds.transpose(1, 2)
    out = detect_layer.postprocess(preds)[0]
    mask = out[:, 4] > 0.25
    out = out[mask]

    if out.shape[0] == 0:
        return None

    # just grab the single highest-confidence detection for now
    best_idx = out[:, 4].argmax()
    row = out[best_idx]
    cx, cy, w, h = row[0].item(), row[1].item(), row[2].item(), row[3].item()
    conf = row[4].item()
    cls = int(row[5].item())

    x1 = int(cx - w / 2)
    y1 = int(cy - h / 2)
    x2 = int(cx + w / 2)
    y2 = int(cy + h / 2)

    return (x1, y1, x2, y2), cls, conf

